  <property name="styleSheet">
   <string notr="true">QPushButton {
    qproperty-flat: false;                 /* evita aspecto plano/transparente */
    qproperty-autoFillBackground: true;    /* fuerza pintado del fondo */
    background-color: #e0e0e0;             /* poné el color que quieras */
    color: #222;
    border: 1px solid #8f8f91;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton:hover { background-color: #dcdcdc; }
QPushButton:pressed, QPushButton:checked { background-color: #c8c8c8; }</string>
  </property>
